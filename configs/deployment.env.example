# PixelForge deployment environment variables
# Copy to a local .env file or export in your shell before starting services.
# Do not commit secrets or machine-specific paths to git.

# ── Repository ───────────────────────────────────────────────────────────────
# PIXELFORGE_ROOT=/path/to/PixelForge

# ── Networking ───────────────────────────────────────────────────────────────
PIXELFORGE_API_HOST=127.0.0.1
PIXELFORGE_API_PORT=8000
PIXELFORGE_FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# PIXELFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Python interpreters (override if conda is not at /opt/anaconda3) ─────────
# PIXELFORGE_BACKEND_PYTHON=/opt/anaconda3/envs/pixelforge-sam2-v2/bin/python
# PIXELFORGE_MOEBIUS_PYTHON=/opt/anaconda3/envs/pixelforge-moebius/bin/python
# PIXELFORGE_GROUNDING_DINO_PYTHON=/opt/anaconda3/envs/pixelforge-grounding-dino/bin/python

# ── Checkpoints (relative to PIXELFORGE_ROOT unless absolute) ────────────────
# PIXELFORGE_SAM2_CHECKPOINT=checkpoints/sam2/sam2.1_hiera_tiny.pt
# PIXELFORGE_MOEBIUS_CHECKPOINT=checkpoints/moebius/ft_places2/diffusion_pytorch_model.bin
# PIXELFORGE_MOEBIUS_VAE=checkpoints/moebius/vae
# PIXELFORGE_GROUNDING_DINO_CHECKPOINT=checkpoints/grounding_dino/groundingdino_swint_ogc.pth

# ── Upload / image limits ────────────────────────────────────────────────────
# PIXELFORGE_MAX_UPLOAD_BYTES=26214400
# PIXELFORGE_MAX_MASK_UPLOAD_BYTES=10485760
# PIXELFORGE_MAX_IMAGE_DIMENSION=4096
# PIXELFORGE_MAX_PROMPT_LENGTH=512

# ── Concurrency / workers ────────────────────────────────────────────────────
# PIXELFORGE_MAX_CONCURRENT_GENERATIONS=1
PIXELFORGE_MOEBIUS_PERSISTENT_WORKER=true
# PIXELFORGE_WORKER_STARTUP_TIMEOUT=180
# PIXELFORGE_WORKER_REQUEST_TIMEOUT=600
# PIXELFORGE_SUBPROCESS_TIMEOUT=600

# ── Cloud endpoints (optional — not locally validated) ─────────────────────────
# PIXELFORGE_PIXELHACKER_ENDPOINT=
# PIXELFORGE_INSTRUCT_PIX2PIX_ENDPOINT=
