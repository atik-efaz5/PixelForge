# Public demo: expose local FastAPI (port 8000) via Cloudflare quick tunnel.
# Start backend first, then:
#   cloudflared tunnel --url http://127.0.0.1:8000
# Copy the https://*.trycloudflare.com URL into Vercel NEXT_PUBLIC_API_BASE_URL
# and add the Vercel site origin to PIXELFORGE_CORS_ORIGINS below.

PIXELFORGE_CORS_ORIGINS=https://frontend-mu-two-wzuqjziue7.vercel.app,http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=https://YOUR_TUNNEL_URL.trycloudflare.com
